{
  "name": "capstonefinal",
  "private": true,
  "version": "0.0.0",
  "homepage": "./",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "electron:dev": "concurrently \"yarn dev\" \"wait-on http://localhost:5173 && yarn electron\"",
    "build": "cross-env NODE_ENV=production VITE_APP_GITHUB_CLIENT_ID=Iv23liWgjGxS1EKPZQTv electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "yarn build && electron-builder --dir",
    "build:win": "yarn build && electron-builder --win",
    "build:mac": "yarn build && electron-builder --mac",
    "build:linux": "yarn build && electron-builder --linux"
  },
  "build": {
    "appId": "com.stl-3d-viewer",
    "productName": "STL 3D Viewer",
    "forceCodeSigning": false,
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "sign": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.25.6",
    "@monaco-editor/react": "^4.6.0",
    "@reduxjs/toolkit": "^2.2.7",
    "ace-builds": "^1.36.2",
    "axios": "^1.7.7",
    "concurrently": "^9.0.1",
    "lucide-react": "^0.454.0",
    "monaco-editor": "^0.52.0",
    "monaco-languageclient": "^8.8.3",
    "re-resizable": "^6.10.1",
    "react": "^18.3.1",
    "react-ace": "^12.0.0",
    "react-console-emulator": "^5.0.2",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-redux": "^9.1.2",
    "react-resizable": "^3.0.5",
    "react-router-dom": "^6.28.0",
    "redux": "^5.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "styled-components": "^6.1.13",
    "uuid": "^11.0.2",
    "vscode-ws-jsonrpc": "^3.3.2",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@babel/plugin-transform-runtime": "^7.25.4",
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "npm-run-all": "^4.1.5",
    "vite": "^5.4.8",
    "vite-plugin-monaco-editor": "^1.1.0",
    "wait-on": "^8.0.1"
  }
}
